#!/bin/sh
# 1) Blocks direct commits on protected branches.
#    Protected: git config hooks.protectedBranches (space or comma separated); default "main master".
#    Bypass: ALLOW_MAIN=1 git commit ...  (or git commit --no-verify)
# 2) Scans staged changes for secrets with gitleaks (hooks.secrets); ALLOW_MAIN does not skip it.

branch=$(git symbolic-ref --short -q HEAD) || branch=""  # detached HEAD: allow

protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
[ -n "$protected" ] || protected="main master"

if [ "${ALLOW_MAIN:-}" != "1" ] && [ -n "$branch" ]; then
  for p in $protected; do
    if [ "$branch" = "$p" ]; then
      {
        echo "✋ Direct commit on protected branch '$branch' is blocked."
        echo "   Create a work branch:  git switch -c feat/<name>"
        echo "   Deliberate bypass:     ALLOW_MAIN=1 git commit ..."
      } >&2
      exit 1
    fi
  done
fi

# CI runs the same scan as a required check.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact || {
    echo "✋ gitleaks found a secret in the staged changes. Remove it before committing." >&2
    exit 1
  }
else
  echo "⚠ gitleaks not installed: secret scan skipped (CI still runs it)." >&2
fi
exit 0
